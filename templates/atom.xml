{%- set site_config = bag('site') -%}
{%- set list = this.listing -%}
{%- set base_url = '/'|url(external=true) -%}
<?xml version="1.0" encoding="utf-8"?>
{#- The feed and entry IDs are the same as the ones ABlog generated, so feed readers don't show old posts as new. #}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en" xml:base="{{ base_url }}">
  <id>{{ base_url.rstrip('/') }}</id>
  <title>{{ site_config.title }}{% if this.listing_source.url_path != '/blog/' %} - {{ list.title }}{% endif %}</title>
  <updated>{{ (list.posts|first).pub_date.isoformat() if list.posts else '2016-01-01' }}T00:00:00+00:00</updated>
  <link href="{{ base_url.rstrip('/') }}"/>
  <link href="{{ this|url(external=true) }}" rel="self"/>
  {%- for post in list.posts %}
  <entry>
    <id>{{ post|url(external=true) }}</id>
    <title>{{ post.title }}</title>
    <updated>{{ post.pub_date.isoformat() }}T00:00:00+00:00</updated>
    <published>{{ post.pub_date.isoformat() }}T00:00:00+00:00</published>
    <author><name>{{ post.author }}</name></author>
    <link href="{{ post|url(external=true) }}"/>
    <summary>{{ post|excerpt|plain_text }}</summary>
    <content type="html">{{ post.body.html|forceescape }}</content>
    {%- for tag in post.tags %}
    <category term="{{ tag }}" label="{{ tag }}"/>
    {%- endfor %}
  </entry>
  {%- endfor %}
</feed>
